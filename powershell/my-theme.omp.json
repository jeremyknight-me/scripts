{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 3,
  "final_space": true,
  "patch_pwsh_bleed": true,
  "console_title_template": "{{if .Root}}[Admin] {{end}}{{ .HostName }} ❯ {{ .Folder }}",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "root",
          "style": "diamond",
          "foreground": "#ffffff",
          "background": "#ff3d3d",
          "template": "\uf023",
          "powerline_symbol": "\ue0b0",
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4",
          "options": {
            "cache_duration": "none"
          }
        },
        {
          "type": "path",
          "style": "powerline",
          "foreground": "#ffffff",
          "background": "#6079bd",
          "template": "\ue5ff {{ .Path }} ",
          "powerline_symbol": "\ue0b0",
          "leading_powerline_symbol": "\ue0b6",
          "options": {
            "cache_duration": "none",
            "folder_separator_icon": "\\",
            "home_icon": "~",
            "style": "mixed",
            "mixed_threshold": 3
          }
        },
        {
          "type": "git",
          "style": "powerline",
          "foreground": "#193549",
          "background": "#fff06a",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#FF9248{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#ff4500{{ end }}",
            "{{ if gt .Ahead 0 }}#B388FF{{ end }}",
            "{{ if gt .Behind 0 }}#B388FF{{ end }}"
          ],
          "template": " {{ .UpstreamIcon }} {{ .RepoName }} {{ .HEAD }} {{ .BranchStatus }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }} \uf692 {{ .StashCount }}{{ end }} ",
          "powerline_symbol": "\ue0b0",
          "options": {
            "branch_max_length": 25,
            "cache_duration": "none",
            "fetch_upstream_icon": true,
            "fetch_stash_count": true,
            "fetch_status": true
          }
        },
        {
          "type": "battery",
          "style": "powerline",
          "foreground": "#efefef",
          "background": "#005e1b",
          "background_templates": [
            "{{ if lt .Percentage 20 }}#ff0000{{ end }}"
          ],
          "template": "{{if eq \"Discharging\" .State.String}} {{ if not .Error }}\uf0e7 {{ .Percentage }}{{ end }}\uf295 {{ end }}",
          "properties": {
            "cache_duration": "none"
          },
          "powerline_symbol": "\ue0b0",
          "options": {
            "cache_duration": "none"
          }
        },
        {
          "type": "project",
          "style": "powerline",
          "foreground": "#ffffff",
          "background": "#1e3999",
          "template": " \ueb30 {{ .Name }}{{ if .Version }} {{ .Version }}{{ end }} ",
          "powerline_symbol": "\ue0b0"
        },
        {
          "type": "executiontime",
          "style": "powerline",
          "foreground": "#ffffff",
          "background": "#545d78",
          "template": " \uf520 {{ .FormattedMs }} ",
          "powerline_symbol": "\ue0b0",
          "options": {
            "always_enabled": false,
            "cache_duration": "none",
            "style": "austin",
            "threshold": 500
          }
        }
      ]
    }
  ]
}
